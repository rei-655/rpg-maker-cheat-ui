{
  "name": "rpg-cheat-ui",
  "version": "2.2.0",
  "description": "Cheat overlay for RPG Maker MV / MZ games",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rei-655/rpg-maker-cheat-ui.git"
  },
  "homepage": "https://github.com/rei-655/rpg-maker-cheat-ui#readme",
  "bugs": {
    "url": "https://github.com/rei-655/rpg-maker-cheat-ui/issues"
  },
  "keywords": [
    "rpg-maker",
    "rpgmaker-mv",
    "rpgmaker-mz",
    "cheat",
    "overlay",
    "vue",
    "nwjs"
  ],
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node tools/package.mjs"
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true
  }
}
